# Everything on, including the Scream receiver (see docs/windows-setup.md before using Scream).
# Build:  idf.py -B build_full -D SDKCONFIG=build_full/sdkconfig -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.full" build
CONFIG_AB_FEATURE_EQ=y
CONFIG_AB_FEATURE_AMBIENT=y
CONFIG_AB_FEATURE_VBAN=y
CONFIG_AB_FEATURE_SCREAM=y
CONFIG_AB_FEATURE_RADIO=y
CONFIG_AB_FEATURE_SYNTH=y
